// One-sample-per-pixel path tracer plus the DLSS-RR guide buffers.
//
// The point of this shader is not beauty, it is *contract fidelity*: it reproduces the
// guide-buffer semantics Caustica feeds to DLSS Ray Reconstruction, so a conclusion drawn
// here transfers to the game.
//
//   gNormal      rgba16f  world-space normal.xyz, GGX roughness in .w
//   gAlbedo      rgba16f  diffuse albedo.rgb (base * (1 - metalness)), .a = emissive flag
//   gDepth       r32f     hardware depth: clip.z / clip.w of a reversed-Z projection
//                         (near = 1, far -> 0), which is why DLSS gets DepthInverted
//   gMotion      rg16f    (previousNdc - jitteredNdc) * 0.5 * renderSize, i.e. render-pixel
//                         units and already jitter-free (MV scale 1.0, MVLowRes)
//   gSpecAlbedo  rgba16f  specular F0 fed to RR for demodulation, .a = 1
//   gSpecMotion  rg16f    reflection motion, same scaling; zeroed above roughness 0.25
//
// Sky matches Caustica's miss handling: normal 0, roughness 1, depth 0, albedo 0.5,
// specular albedo 0 -- and its motion reprojects the ray direction as a point at infinity,
// so a pure camera rotation still produces correct background motion vectors.
//
// Vertex attributes are plain float arrays indexed arithmetically rather than an interleaved
// struct, because vec3 in std430 has 16-byte alignment rules that are easy to get subtly
// wrong between C++ and GLSL.

#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;

layout(std140, set = 0, binding = 1) uniform Frame {
    vec4 viewProj[4];      // row-major, matching the layout NGX wants
    vec4 prevViewProj[4];
    vec4 camPos;           // xyz = position, w = frame index
    vec4 prevCamPos;       // xyz = previous position
    vec4 camRight;         // xyz = right, w = tanHalfFovX
    vec4 camUp;            // xyz = up,    w = tanHalfFovY
    vec4 camFwd;           // xyz = forward
    vec4 jitterRender;     // xy = jitter in render pixels, z = renderW, w = renderH
    vec4 displayCounts;    // xy = displayW/H, z = emitter count
    vec4 sunDir;           // xyz = direction toward the sun, w = sky intensity
    vec4 sunColor;         // rgb = sun tint
} F;

layout(rgba16f, set = 0, binding = 2) uniform writeonly image2D outColor;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image2D gNormal;
layout(rgba16f, set = 0, binding = 4) uniform writeonly image2D gAlbedo;
layout(r32f,    set = 0, binding = 5) uniform writeonly image2D gDepth;
layout(rg16f,   set = 0, binding = 6) uniform writeonly image2D gMotion;
layout(rgba16f, set = 0, binding = 7) uniform writeonly image2D gSpecAlbedo;
layout(rg16f,   set = 0, binding = 8) uniform writeonly image2D gSpecMotion;

layout(std430, set = 0, binding = 9)  readonly buffer Positions  { float v[]; } positions;
layout(std430, set = 0, binding = 10) readonly buffer Normals    { float v[]; } normals;
layout(std430, set = 0, binding = 11) readonly buffer Albedos    { float v[]; } albedos;
layout(std430, set = 0, binding = 12) readonly buffer Params     { float v[]; } matParams;
layout(std430, set = 0, binding = 13) readonly buffer Indices    { uint  v[]; } indices;
layout(std430, set = 0, binding = 14) readonly buffer EmitterPos { float v[]; } emitterPos;
layout(std430, set = 0, binding = 15) readonly buffer EmitterRad { float v[]; } emitterRad;

const float PI = 3.14159265359;
const float RAY_TMIN = 1.0e-3;
const float RAY_TMAX = 1.0e5;
const float SURF_BIAS = 0.005;
const float MIRROR_ALPHA_MAX = 4.0e-4;      // Caustica world_core.slang
const float SPEC_MOTION_ALPHA_MAX = 0.25;   // Caustica world_core.slang

// --- rng ------------------------------------------------------------------------------

uint g_state;

uint pcg(uint v) {
    uint s = v * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}
float rnd() {
    g_state = pcg(g_state);
    return float(g_state) * (1.0 / 4294967296.0);
}

// --- math -----------------------------------------------------------------------------

vec4 mulViewProj(vec3 p) {
    vec4 v = vec4(p, 1.0);
    return vec4(dot(F.viewProj[0], v), dot(F.viewProj[1], v),
                dot(F.viewProj[2], v), dot(F.viewProj[3], v));
}
vec4 mulPrevViewProj(vec3 p) {
    vec4 v = vec4(p, 1.0);
    return vec4(dot(F.prevViewProj[0], v), dot(F.prevViewProj[1], v),
                dot(F.prevViewProj[2], v), dot(F.prevViewProj[3], v));
}
// Returns clip.xyz / clip.w, which for our projection is ndc.xy plus the reversed-Z depth.
vec3 projectNdc(bool previous, vec3 worldPos, out bool valid) {
    vec4 c = previous ? mulPrevViewProj(worldPos) : mulViewProj(worldPos);
    valid = c.w > 0.0;
    return valid ? c.xyz / c.w : vec3(0.0);
}

void basis(vec3 n, out vec3 t, out vec3 b) {
    vec3 helper = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    t = normalize(cross(helper, n));
    b = cross(n, t);
}
vec3 toWorld(vec3 n, vec3 localDir) {
    vec3 t, b;
    basis(n, t, b);
    return normalize(t * localDir.x + b * localDir.y + n * localDir.z);
}

// --- scene ----------------------------------------------------------------------------

struct Hit {
    bool  hit;
    float t;
    vec3  pos;
    vec3  nrm;
    vec3  albedo;
    vec3  emission;
    float rough;
    float metal;
    bool  emissive;
};

Hit trace(vec3 ro, vec3 rd, float tmax) {
    Hit h;
    h.hit = false; h.t = 0.0; h.pos = vec3(0.0); h.nrm = vec3(0.0);
    h.albedo = vec3(0.0); h.emission = vec3(0.0);
    h.rough = 1.0; h.metal = 0.0; h.emissive = false;

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, ro, RAY_TMIN, rd, tmax);
    while (rayQueryProceedEXT(rq)) {}

    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return h;
    }

    h.hit = true;
    h.t = rayQueryGetIntersectionTEXT(rq, true);
    h.pos = ro + rd * h.t;

    uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
    vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
    uint i0 = indices.v[prim * 3u + 0u];
    uint i1 = indices.v[prim * 3u + 1u];
    uint i2 = indices.v[prim * 3u + 2u];

    // Materials are uniform across a triangle, so only the normal is interpolated.
    // Barycentrics are (u, v) and the first vertex weight is 1 - u - v.
    float w0 = 1.0 - bary.x - bary.y;
    vec3 n0 = vec3(normals.v[i0 * 3u + 0u], normals.v[i0 * 3u + 1u], normals.v[i0 * 3u + 2u]);
    vec3 n1 = vec3(normals.v[i1 * 3u + 0u], normals.v[i1 * 3u + 1u], normals.v[i1 * 3u + 2u]);
    vec3 n2 = vec3(normals.v[i2 * 3u + 0u], normals.v[i2 * 3u + 1u], normals.v[i2 * 3u + 2u]);
    h.nrm = normalize(n0 * w0 + n1 * bary.x + n2 * bary.y);

    h.albedo = vec3(albedos.v[i0 * 3u + 0u], albedos.v[i0 * 3u + 1u], albedos.v[i0 * 3u + 2u]);
    h.rough = matParams.v[i0 * 6u + 0u];
    h.metal = matParams.v[i0 * 6u + 1u];
    h.emissive = matParams.v[i0 * 6u + 2u] > 0.5;
    h.emission = vec3(matParams.v[i0 * 6u + 3u], matParams.v[i0 * 6u + 4u], matParams.v[i0 * 6u + 5u]);
    return h;
}

bool occluded(vec3 ro, vec3 rd, float tmax) {
    if (tmax <= RAY_TMIN) {
        return false;
    }
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, ro, RAY_TMIN, rd, tmax);
    while (rayQueryProceedEXT(rq)) {}
    return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

vec3 skyRadiance(vec3 dir) {
    vec3 horizon = vec3(0.72, 0.78, 0.90);
    vec3 zenith  = vec3(0.16, 0.31, 0.70);
    vec3 ground  = vec3(0.085, 0.082, 0.080);
    float up = dir.y;
    vec3 c = up > 0.0 ? mix(horizon, zenith, pow(up, 0.55))
                      : mix(horizon, ground, clamp(-up * 2.5, 0.0, 1.0));
    // A soft, wide sun disc rather than a delta light: at 1 spp a delta light is only
    // reachable through the emitter list anyway, and a broad disc gives an emitter the
    // denoiser can actually work with.
    float sun = max(dot(dir, normalize(F.sunDir.xyz)), 0.0);
    c += F.sunColor.rgb * pow(sun, 400.0) * 24.0;
    return c * F.sunColor.rgb * F.sunDir.w;
}

// --- brdf -----------------------------------------------------------------------------

float distributionGGX(float ndoth, float a) {
    float a2 = a * a;
    float d = ndoth * ndoth * (a2 - 1.0) + 1.0;
    return a2 / max(PI * d * d, 1.0e-8);
}
float smithG1(float ndotv, float a) {
    float k = (a * a) * 0.5;
    return ndotv / max(ndotv * (1.0 - k) + k, 1.0e-6);
}
vec3 fresnelSchlick(float cosTheta, vec3 f0) {
    return f0 + (1.0 - f0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 sampleGgxHalf(float a, vec3 n, out float pdfHalf) {
    float u1 = rnd(), u2 = rnd();
    float phi = 2.0 * PI * u1;
    float cosTheta = sqrt((1.0 - u2) / (1.0 + (a * a - 1.0) * u2));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    vec3 h = toWorld(n, vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta));
    pdfHalf = distributionGGX(cosTheta, a) * cosTheta;
    return h;
}

vec3 sampleCosineHemisphere(vec3 n, out float pdf) {
    float u1 = rnd(), u2 = rnd();
    float phi = 2.0 * PI * u1;
    float r = sqrt(u2);
    vec3 d = toWorld(n, vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u2))));
    pdf = max(dot(d, n), 0.0) / PI;
    return d;
}

// Next-event estimation against one uniformly chosen emissive sphere. Sampling the visible
// cap folds the 1/d^2 and the light-side cosine into the solid-angle density, so the
// estimator is just f * Le * cosSurface / pdf.
vec3 sampleEmitters(vec3 p, vec3 n, vec3 wo, vec3 f0, float rough, float metal) {
    int count = int(F.displayCounts.z);
    if (count <= 0) {
        return vec3(0.0);
    }
    int e = min(int(rnd() * float(count)), count - 1);
    vec3 lp = vec3(emitterPos.v[e * 4 + 0], emitterPos.v[e * 4 + 1], emitterPos.v[e * 4 + 2]);
    float lr = emitterPos.v[e * 4 + 3];

    vec3 toLight = p - lp;
    float dist2 = dot(toLight, toLight);
    float dist = sqrt(dist2);
    if (dist <= lr + 1.0e-4) {
        return vec3(0.0);
    }

    vec3 ln = normalize(toLight);
    vec3 sp = lp + ln * lr;
    vec3 toSample = sp - p;
    float shadowDist = length(toSample);
    vec3 wi = toSample / max(shadowDist, 1.0e-6);

    float ndotl = dot(n, wi);
    if (ndotl <= 0.0) {
        return vec3(0.0);
    }
    if (occluded(p + n * SURF_BIAS, wi, shadowDist - 1.0e-3)) {
        return vec3(0.0);
    }

    float sinThetaMax2 = (lr * lr) / dist2;
    float cosThetaMax = sqrt(max(0.0, 1.0 - sinThetaMax2));
    float solidAngle = 2.0 * PI * (1.0 - cosThetaMax);
    float pdf = 1.0 / (float(count) * max(solidAngle, 1.0e-6));

    vec3 h = normalize(wi + wo);
    float ndoth = max(dot(n, h), 0.0);
    float ndotv = max(dot(n, wo), 1.0e-4);
    float a = max(rough * rough, 1.0e-4);
    vec3  fr = fresnelSchlick(max(dot(h, wo), 0.0), f0);
    float spec = distributionGGX(ndoth, a) * smithG1(ndotv, a) * smithG1(ndotl, a)
               / (4.0 * ndotv * ndotl);
    vec3  diffuse = (1.0 - fr) * (1.0 - metal) * (1.0 / PI);

    vec3 le = vec3(emitterRad.v[e * 4 + 0], emitterRad.v[e * 4 + 1],
                   emitterRad.v[e * 4 + 2]) * emitterRad.v[e * 4 + 3];
    return (diffuse + fr * spec) * le * ndotl / pdf;
}

// Second hit: its own emission plus one more direct-light sample. No further recursion.
vec3 shadeSecondBounce(Hit h, vec3 wo) {
    if (h.emissive) {
        return h.emission;
    }
    vec3 f0 = mix(vec3(0.04), h.albedo, h.metal);
    return sampleEmitters(h.pos, h.nrm, wo, f0, h.rough, h.metal);
}

// Primary hit: direct lighting plus one stochastic bounce. Sampling a single BRDF lobe per
// pixel is deliberate -- it is what leaves the input noisy enough for Ray Reconstruction to
// have real work to do.
vec3 shadePrimary(Hit h, vec3 wo) {
    if (h.emissive) {
        return h.emission;
    }

    vec3 n = h.nrm;
    vec3 f0 = mix(vec3(0.04), h.albedo, h.metal);
    vec3 L = sampleEmitters(h.pos, n, wo, f0, h.rough, h.metal);

    float a = max(h.rough * h.rough, 1.0e-4);
    float specWeight = clamp(max(f0.r, max(f0.g, f0.b)) + h.metal * 0.5, 0.04, 0.96);
    float ndotv = max(dot(n, wo), 1.0e-4);

    vec3 wi, f;
    float pdf;
    if (rnd() < specWeight) {
        float pdfHalf;
        vec3 hv = sampleGgxHalf(a, n, pdfHalf);
        wi = reflect(-wo, hv);
        float ndotl = dot(n, wi);
        float vdh = dot(hv, wo);
        if (ndotl <= 0.0 || pdfHalf <= 1.0e-6 || vdh <= 1.0e-6) {
            return L;
        }
        vec3 fr = fresnelSchlick(vdh, f0);
        float spec = distributionGGX(max(dot(n, hv), 0.0), a) * smithG1(ndotv, a)
                   * smithG1(ndotl, a) / (4.0 * ndotv * max(ndotl, 1.0e-4));
        f = fr * spec;
        pdf = (pdfHalf / (4.0 * vdh)) * specWeight;
    } else {
        wi = sampleCosineHemisphere(n, pdf);
        vec3 fr = fresnelSchlick(max(dot(n, wi), 0.0), f0);
        f = (1.0 - fr) * (1.0 - h.metal) * h.albedo / PI;
        pdf *= (1.0 - specWeight);
    }

    if (dot(wi, n) <= 0.0 || pdf <= 1.0e-8) {
        return L;
    }

    Hit h2 = trace(h.pos + n * SURF_BIAS, wi, RAY_TMAX);
    vec3 Li = h2.hit ? shadeSecondBounce(h2, -wi) : skyRadiance(wi);
    return L + f * Li * dot(n, wi) / pdf;
}

// --- main -----------------------------------------------------------------------------

vec2 pixelNdc(ivec2 pix, vec2 jitter, vec2 size) {
    vec2 p = (vec2(pix) + 0.5 + jitter) / size;
    return vec2(p.x * 2.0 - 1.0, 1.0 - p.y * 2.0);
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    int rw = int(F.jitterRender.z);
    int rh = int(F.jitterRender.w);
    if (pix.x >= rw || pix.y >= rh) {
        return;
    }

    g_state = pcg(uint(pix.x) * 1973u + uint(pix.y) * 9277u
                + uint(F.camPos.w) * 26699u + 1u);

    vec2 size = F.jitterRender.zw;
    vec2 jitter = F.jitterRender.xy;
    vec2 jndc = pixelNdc(pix, jitter, size);

    vec3 rayDir = normalize(F.camFwd.xyz
            + F.camRight.xyz * (jndc.x * F.camRight.w)
            + F.camUp.xyz * (jndc.y * F.camUp.w));
    vec3 rayOrigin = F.camPos.xyz;

    Hit h = trace(rayOrigin, rayDir, RAY_TMAX);

    vec4 color;
    vec4 outNormal;
    vec4 outAlbedo;
    float outDepth;
    vec2 outMotion;
    vec4 outSpecAlbedo = vec4(0.0, 0.0, 0.0, 1.0);
    vec2 outSpecMotion = vec2(0.0);
    bool valid;

    if (!h.hit) {
        color = vec4(skyRadiance(rayDir), 1.0);
        // Caustica's sky guide tuple: normal 0, roughness 1, plain 0.5 diffuse albedo.
        outNormal = vec4(0.0, 0.0, 0.0, 1.0);
        outAlbedo = vec4(0.5, 0.5, 0.5, 0.0);
        // Reversed-Z: a miss is the far plane, whose depth is 0.
        outDepth = 0.0;
        // Reproject the direction as a point at infinity so a pure rotation still moves it.
        vec3 skyCur = rayOrigin + rayDir * 1.0e5;
        vec3 skyPrev = F.prevCamPos.xyz + rayDir * 1.0e5;
        bool vc, vp;
        vec3 curNdc = projectNdc(false, skyCur, vc);
        vec3 prevNdc = projectNdc(true, skyPrev, vp);
        outMotion = (vc && vp) ? (prevNdc.xy - jndc) * 0.5 * size : vec2(0.0);
    } else {
        color = vec4(shadePrimary(h, -rayDir), 1.0);

        outNormal = vec4(h.nrm, h.rough);
        outAlbedo = vec4(h.albedo * (1.0 - h.metal), h.emissive ? 1.0 : 0.0);

        vec3 curNdc = projectNdc(false, h.pos, valid);
        outDepth = valid ? curNdc.z : 0.0;

        // Motion is jitter-free: the hit's current screen position IS the jittered ray NDC,
        // so subtracting jndc (not the pixel centre) is what zeroes it in a static shot.
        vec3 prevNdc = projectNdc(true, h.pos, valid);
        outMotion = valid ? (prevNdc.xy - jndc) * 0.5 * size : vec2(0.0);

        // Specular guides mirror Caustica's resolveSpecularGuides: refine the demodulation
        // albedo only for near-mirror opaque non-emissive reflectors, and zero the
        // reflection motion above the roughness gate.
        vec3 f0 = mix(vec3(0.04), h.albedo, h.metal);
        outSpecAlbedo = vec4(f0, 1.0);

        if (length(h.nrm) > 0.5 && h.rough <= SPEC_MOTION_ALPHA_MAX) {
            vec3 specDir = reflect(rayDir, h.nrm);
            Hit hr = trace(h.pos + h.nrm * SURF_BIAS, specDir, RAY_TMAX);
            vec3 reflectedHit = hr.hit ? hr.pos : h.pos + specDir * 1.0e6;

            if (h.rough <= MIRROR_ALPHA_MAX && hr.hit && !hr.emissive) {
                vec3 reflectedDiffuse = hr.albedo * (1.0 - hr.metal);
                if (max(reflectedDiffuse.r, max(reflectedDiffuse.g, reflectedDiffuse.b)) > 0.001) {
                    outSpecAlbedo = vec4(f0 * reflectedDiffuse, 1.0);
                }
            }

            // Mirror the reflected hit across the primary surface plane. The reflected image
            // is seen at this pixel, so the current NDC is jndc.
            vec3 n = normalize(h.nrm);
            vec3 mirrored = reflectedHit - 2.0 * n * dot(reflectedHit - h.pos, n);
            bool vm;
            vec3 prevSpecNdc = projectNdc(true, mirrored, vm);
            outSpecMotion = vm ? (prevSpecNdc.xy - jndc) * 0.5 * size : vec2(0.0);
        }
    }

    imageStore(outColor, pix, color);
    imageStore(gNormal, pix, outNormal);
    imageStore(gAlbedo, pix, outAlbedo);
    imageStore(gDepth, pix, vec4(outDepth, 0.0, 0.0, 0.0));
    imageStore(gMotion, pix, vec4(outMotion, 0.0, 0.0));
    imageStore(gSpecAlbedo, pix, outSpecAlbedo);
    imageStore(gSpecMotion, pix, vec4(outSpecMotion, 0.0, 0.0));
}
