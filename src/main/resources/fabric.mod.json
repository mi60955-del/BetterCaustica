{
	"schemaVersion": 1,
	"id": "bettercaustica",
	"version": "${version}",
	"name": "BetterCaustica",
	"description": "Hardware-ray-traced renderer with DLSS Ray Reconstruction and volumetric fog and clouds for the Minecraft Vulkan backend.",
	"authors": [
		"island_i (BetterCaustica)",
		"ComfyFluffy (Caustica)"
	],
	"license": "LGPL-3.0-or-later",
	"environment": "client",
	"entrypoints": {
		"main": [
			"dev.comfyfluffy.caustica.CausticaMod"
		],
		"client": [
			"dev.comfyfluffy.caustica.client.CausticaClient"
		],
		"modmenu": [
			"dev.comfyfluffy.caustica.client.CausticaModMenu"
		],
		"sodium:config_api_user": [
			"dev.comfyfluffy.caustica.client.CausticaSodiumConfig"
		]
	},
	"mixins": [
		"bettercaustica.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"sodium": "*"
	}
}
